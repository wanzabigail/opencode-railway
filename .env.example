# =============================================================================
# Konfigurasi lokal untuk deploy.sh (JANGAN commit file .env)
# =============================================================================

# --- Password ------------------------------------------------------------
# Kosongkan untuk auto-generate. deploy.sh akan membuat password acak 32
# karakter, menyetelnya sebagai variable Railway, dan menyimpannya di
# .deploy-credentials. Kalau container jalan tanpa variable ini (mis. deploy
# dari dashboard), start.sh membuat password dan menyimpannya di volume:
#   /data/home/.opencode-server-password
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_PASSWORD_FILE=/data/home/.opencode-server-password

# --- Public networking ---------------------------------------------------
# http  -> domain HTTPS Railway (*.up.railway.app)          [default]
# tcp   -> TCP proxy mentah (tanpa TLS)
# both  -> HTTP domain + TCP proxy
# none  -> tidak membuat public networking baru (private network tetap aktif)
PUBLIC_NETWORKING=http

# Port aplikasi yang diekspos lewat TCP proxy (default: APP_PORT).
# TCP_PROXY_PORT=8080

# --- Auto-update ---------------------------------------------------------
# Cek npm tiap N detik; kalau ada versi stabil baru, pasang & restart server.
OPENCODE_AUTO_UPDATE=true
OPENCODE_AUTO_UPDATE_INTERVAL=21600

# --- Hemat RAM/CPU -------------------------------------------------------
# true  -> matikan LSP, formatter, snapshot, warming, plugin, file watcher
# false -> fitur OpenCode lengkap (lebih berat)
OPENCODE_LOW_RESOURCE=true

# --- Railway -------------------------------------------------------------
PROJECT_NAME=opencode-railway
SERVICE_NAME=opencode-railway
APP_PORT=8080

# Opsional: login non-interaktif, buat di https://railway.com/account/tokens
# RAILWAY_TOKEN=

# --- Provider model (isi salah satu / beberapa) --------------------------
# OpenCode membaca API key provider dari environment.
# OPENCODE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GROQ_API_KEY=

# --- Git / GitHub (dipakai push-github.sh) -------------------------------
# REPO_NAME=opencode-railway
# VISIBILITY=public
# GITHUB_TOKEN=
