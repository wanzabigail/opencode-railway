{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "lsp": false,
  "formatter": false,
  "snapshots": false,
  "warming": false,
  "plugins": [],
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/objects/**",
      "**/.cache/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/coverage/**",
      "**/.next/**",
      "**/target/**",
      "**/vendor/**"
    ]
  }
}
